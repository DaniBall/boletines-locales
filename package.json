{
  "name": "boletines-locales",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:todas": "for c in jaen leon vitoria; do CIUDAD=$c astro build || exit 1; done",
    "deploy": "wrangler deploy --config ciudades/$CIUDAD/wrangler.jsonc",
    "typecheck": "CIUDAD=jaen astro check && tsc --noEmit -p tsconfig.pipeline.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "edicion": "tsx scripts/cli.ts edicion",
    "fuentes": "tsx scripts/cli.ts fuentes",
    "whatsapp": "tsx scripts/cli.ts whatsapp"
  },
  "dependencies": {
    "astro": "^7.3.3",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.2",
    "gray-matter": "^4.0.3",
    "luxon": "^3.7.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.0.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
