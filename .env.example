# Copia este archivo a .env y rellena los valores. El .env nunca se commitea.

# Fase 1
ANTHROPIC_API_KEY=
# En los entornos de Claude Code, ANTHROPIC_API_KEY no llega a los comandos: usa este nombre.
# BOLETINES_ANTHROPIC_API_KEY=
AEMET_API_KEY=

# Modelo de redacción (opcional; por defecto el de pipeline/config.ts)
CLAUDE_MODEL=claude-sonnet-5

# Fase 2 (WhatsApp Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
