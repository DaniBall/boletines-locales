---
/**
 * La campana del ensayo: suscribe a los avisos de cada borrador nuevo por
 * ntfy, una app gratuita de notificaciones. La web es estática y no puede
 * mandar avisos ella misma; los manda `avisos.yml` al tema de la ciudad.
 */
interface Props {
  /** Tema público de ntfy.sh (`rehearsal.notifyTopic` de la ciudad). */
  tema: string;
}

const { tema } = Astro.props;
const enlace = `https://ntfy.sh/${encodeURIComponent(tema)}`;
---

<div class="campana">
  <a class="boton campana__boton" href={enlace} rel="noopener">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none">
      <path
        d="M12 3a6 6 0 0 0-6 6v3.5L4.5 15v1.5h15V15L18 12.5V9a6 6 0 0 0-6-6Z"
        stroke="currentColor"
        stroke-width="2"
        stroke-linejoin="round"
      ></path>
      <path
        d="M10 19a2 2 0 0 0 4 0"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      ></path>
    </svg>
    Avisarme de cada borrador
  </a>
  <p class="meta campana__ayuda">
    Se abre ntfy, una app gratuita de avisos: pulsa «Subscribe» y permite las notificaciones. En el
    móvil va mejor con la app ntfy (Android o iPhone), suscribiéndote al tema <code>{tema}</code>.
  </p>
</div>

<style>
  .campana {
    margin-block: 1.25rem;
  }

  .campana__boton {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .campana__ayuda {
    margin: 0.5rem 0 0;
  }

  .campana__ayuda code {
    font-family: var(--fuente-mono);
    overflow-wrap: anywhere;
  }
</style>
