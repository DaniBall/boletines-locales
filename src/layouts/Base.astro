---
import '../styles/global.css';
import { ciudadActual } from '../../ciudades/index.ts';
import { tagline } from '../../pipeline/config.ts';

interface Props {
  title: string;
  description?: string;
  /** Páginas que no deben salir en buscadores, como las del ensayo. */
  noindex?: boolean;
}

const ciudad = ciudadActual();
const promesa = tagline(ciudad.name);
const { title, description = promesa, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <link rel="canonical" href={Astro.url.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <header class="cabecera">
      <div class="contenedor">
        <nav>
          <a class="cabecera__marca" href="/">
            {ciudad.brand.name}
          </a>
          <a href="/ediciones/">Ediciones anteriores</a>
        </nav>
      </div>
    </header>

    <main class="contenedor">
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor">
        <p>
          {ciudad.brand.name}. {promesa}
        </p>
        <p>Esta web no usa cookies ni rastrea a quien la lee.</p>
      </div>
    </footer>
  </body>
</html>
